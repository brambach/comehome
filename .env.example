# Postgres. Local dev uses the preinstalled Postgres 16; production uses Neon or Supabase.
DATABASE_URL=postgres://comehome:comehome@localhost:5432/comehome

# Public origin used in QR codes, emails, and Open Graph URLs (no trailing slash).
# Read at request time on the server, so one build works on any domain.
SITE_URL=http://localhost:3000

# Storage adapter: "disk" (dev, writes to .data/uploads) or "blob" (Vercel Blob).
STORAGE_DRIVER=disk
# Required when STORAGE_DRIVER=blob. Vercel sets this when you connect a Blob store.
BLOB_READ_WRITE_TOKEN=

# Mail adapter: "console" (dev, logs to stdout) or "resend".
MAIL_DRIVER=console
# Required when MAIL_DRIVER=resend.
RESEND_API_KEY=
# Verified sender, e.g. "comehome <alerts@yourdomain.com>".
MAIL_FROM=comehome <alerts@example.com>

# Salt for hashing reporter IPs in the rate-limit table. Any long random string.
RATE_LIMIT_SALT=change-me

# Unit tests that touch the database use this one (migrated by tests/unit/global-setup.ts).
TEST_DATABASE_URL=postgres://comehome:comehome@localhost:5432/comehome_test
